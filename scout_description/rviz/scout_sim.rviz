Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Color: 160; 160; 164
      Cell Size: 1
      Plane Cell Count: 20
      Normal Cell Count: 0
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
      TF Prefix: ""
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: D435 PointCloud
      Enabled: true
      Value: true
      Color Transformer: RGB8
      Size (Pixels): 2
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Value: /camera/depth/color/points
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Image
      Name: D435 Depth Image
      Enabled: false
      Value: false
      Normalize Range: true
      Topic:
        Value: /camera/aligned_depth_to_color/image_raw
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Image
      Name: D435 RGB Image
      Enabled: false
      Value: false
      Normalize Range: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.3
      Yaw: 3.14
Window Geometry:
  Height: 800
  Width: 1200
